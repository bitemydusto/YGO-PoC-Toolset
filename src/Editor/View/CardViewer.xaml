<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Editor.ViewModel"
             x:DataType="viewmodel:CardViewerVM"
             x:Class="Editor.View.CardViewer">
    <Grid>
        <Grid RowDefinitions="auto,*">
            <HorizontalStackLayout  Grid.Row="0" Spacing="5">
                <Button Text="Open Library" Command="{Binding OpenLibraryCommand}" CornerRadius="0" WidthRequest="125"/>
                <Button Text="Save Library" Command="{Binding SaveLibraryCommand}" CornerRadius="0" WidthRequest="125" IsEnabled="{Binding IsLibraryLoaded}"/>
                <Button Text="Import Cards" Command="{Binding ImportCardsCommand}" CornerRadius="0" WidthRequest="125" IsEnabled="{Binding IsLibraryLoaded}"/>
                <Button Text="Export Selected" Command="{Binding ExportSelectedCommand}" CornerRadius="0" WidthRequest="130" IsEnabled="{Binding IsLibraryLoaded}"/>
            </HorizontalStackLayout>
            <Grid Grid.Row="1" ColumnDefinitions="auto,*,auto" Margin="10" IsVisible="{Binding IsLibraryLoaded}">
                <Grid Grid.Column="0" RowDefinitions="auto,auto,auto,*" WidthRequest="350">
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="Results:"/>
                            <Label Text="{Binding Cards.Count}"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,auto">
                        <SearchBar Grid.Column="0" Placeholder="Search" Margin="0,0,0,5" Text="{Binding SearchText}"/>
                        <Button Grid.Column="1" Text="Filters" HorizontalOptions="End" VerticalOptions="Start" Margin="0" Padding="0" CornerRadius="0"
                                Command="{Binding ToggleFilterDisplayCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ShowFilters}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding ShowFilters}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2" IsVisible="{Binding ShowFilters}">
                        <Border>
                            <VerticalStackLayout Margin="5">
                                <Label Text="Monsters"/>
                                <Grid ColumnDefinitions="auto,auto" HorizontalOptions="Center">
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="0" WidthRequest="100">
                                        <Label Text="Normal" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.Normal}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="1" WidthRequest="100">
                                        <Label Text="Effect" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.Effect}" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="auto,auto" HorizontalOptions="Center">
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="0" WidthRequest="100">
                                        <Label Text="Fusion" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.Fusion}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="1" WidthRequest="100">
                                        <Label Text="Ritual" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.Ritual}" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                                <Label Text="Spells"/>
                                <Grid ColumnDefinitions="auto,auto,auto" HorizontalOptions="Center">
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="0" WidthRequest="100">
                                        <Label Text="Normal" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.NormalSpell}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="1" WidthRequest="100">
                                        <Label Text="Quick" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.QuickPlaySpell}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="2" WidthRequest="100">
                                        <Label Text="Equip" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.EquipSpell}" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                                <Grid ColumnDefinitions="auto,auto,auto" HorizontalOptions="Center">
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="0" WidthRequest="100">
                                        <Label Text="Field" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.FieldSpell}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="1" WidthRequest="100">
                                        <Label Text="Cont." Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.ContinuousSpell}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="2" WidthRequest="100">
                                        <Label Text="Ritual" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.RitualSpell}" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                                <Label Text="Traps"/>
                                <Grid ColumnDefinitions="auto,auto,auto" HorizontalOptions="Center">
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="0" WidthRequest="100">
                                        <Label Text="Normal" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.NormalTrap}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="1" WidthRequest="100">
                                        <Label Text="Cont." Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.ContinuousTrap}" HorizontalOptions="End"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,auto" Grid.Column="2" WidthRequest="100">
                                        <Label Text="Counter" Grid.Column="0" VerticalOptions="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Filters.CounterTrap}" HorizontalOptions="End"/>
                                    </Grid>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <CollectionView Grid.Row="3" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:CardInfoVM">
                                <Label Text="{Binding DisplayName}" LineBreakMode="TailTruncation"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
                <Image Grid.Column="1" Source="{Binding SelectedCard.ImagePath}" Margin="15"/>
                <Grid Grid.Column="2" RowDefinitions="auto,*" Margin="10" WidthRequest="500" IsVisible="{Binding IsCardSelected}">
                    <VerticalStackLayout Grid.Row="0">
                        <Grid ColumnDefinitions="auto,*" Margin="5">
                            <Label Grid.Column="0" Text="Name" VerticalOptions="Center" WidthRequest="75"/>
                            <Entry Grid.Column="1" Text="{Binding SelectedCard.Name}" MaxLength="64"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="10" Margin="5">
                            <Grid Grid.Column="0" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="Level" VerticalOptions="Center" WidthRequest="75"/>
                                <Picker Grid.Column="1" WidthRequest="150" HorizontalOptions="Start" ItemsSource="{Binding LevelList}"
                                SelectedIndex="{Binding SelectedCard.Level}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="." x:DataType="x:String"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Grid>
                            <Grid Grid.Column="0" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="Attribute" VerticalOptions="Center" WidthRequest="75"/>
                                <Picker Grid.Column="1" WidthRequest="150" HorizontalOptions="Start" ItemsSource="{Binding AttributeList}"
                                SelectedIndex="{Binding SelectedAttributeIndex}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="." x:DataType="x:String"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Grid>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10" Margin="5">
                            <Grid Grid.Column="0" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="Race" VerticalOptions="Center" WidthRequest="75"/>
                                <Picker Grid.Column="1" WidthRequest="150" HorizontalOptions="Start" ItemsSource="{Binding TypeList}"
                                SelectedIndex="{Binding SelectedTypeIndex}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="." x:DataType="x:String"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Grid>
                            <Grid Grid.Column="0" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="Card type" VerticalOptions="Center" WidthRequest="75"/>
                                <Picker Grid.Column="1" WidthRequest="150" HorizontalOptions="Start" ItemsSource="{Binding SubTypeList}"
                                SelectedIndex="{Binding SelectedSubTypeIndex}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="." x:DataType="x:String"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Grid>
                        </HorizontalStackLayout>
                        <Grid Grid.Column="0" ColumnDefinitions="auto,*" Margin="5">
                            <Label Grid.Column="0" Text="S/T" VerticalOptions="Center" WidthRequest="75"/>
                            <Picker Grid.Column="1" WidthRequest="150" HorizontalOptions="Start" ItemsSource="{Binding SpellTrapList}"
                                SelectedIndex="{Binding SelectedSpellTrapTypeIndex}">
                                <Picker.ItemDisplayBinding>
                                    <Binding Path="." x:DataType="x:String"/>
                                </Picker.ItemDisplayBinding>
                            </Picker>
                        </Grid>
                        <HorizontalStackLayout Spacing="10" Margin="5">
                            <Grid Grid.Column="0" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="ATK" VerticalOptions="Center" WidthRequest="75"/>
                                <Entry Grid.Column="1" Text="{Binding SelectedCard.ATK}" WidthRequest="150"/>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="auto,*">
                                <Label Grid.Column="0" Text="DEF" VerticalOptions="Center" WidthRequest="75"/>
                                <Entry Grid.Column="1" Text="{Binding SelectedCard.DEF}" WidthRequest="150"/>
                            </Grid>
                        </HorizontalStackLayout>
                        <Grid Grid.Column="0" ColumnDefinitions="auto,auto,*" Margin="5">
                            <Label Grid.Column="0" Text="IMG" VerticalOptions="Center" WidthRequest="75"/>
                            <Entry Grid.Column="1" Text="{Binding SelectedCard.ImageName}" WidthRequest="150"/>
                            <Label Grid.Column="2" Text="{Binding SelectedCard.ImageError}" TextColor="Red" VerticalOptions="Center" Margin="10"/>
                        </Grid>
                        <Grid Grid.Column="0" ColumnDefinitions="auto,*" Margin="5">
                            <Label Grid.Column="0" Text="Binary" VerticalOptions="Center" WidthRequest="75"/>
                            <Label Grid.Column="1" Text="{Binding SelectedCard.PropertyBits}"/>
                        </Grid>
                        <Grid Grid.Column="0" ColumnDefinitions="auto,*" Margin="5">
                            <Label Grid.Column="0" Text="Versions" VerticalOptions="Center" WidthRequest="75"/>
                            <HorizontalStackLayout Grid.Column="1">
                                <Grid ColumnDefinitions="auto,auto">
                                    <Label Grid.Column="0" Text="Yugi" VerticalOptions="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SelectedCard.VersionYugi}"/>
                                </Grid>
                                <Grid ColumnDefinitions="auto,auto">
                                    <Label Grid.Column="0" Text="Kaiba" VerticalOptions="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SelectedCard.VersionKaiba}"/>
                                </Grid>
                                <Grid ColumnDefinitions="auto,auto">
                                    <Label Grid.Column="0" Text="Joey" VerticalOptions="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SelectedCard.VersionJoey}"/>
                                </Grid>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                    <Editor Grid.Row="1" Text="{Binding SelectedCard.Description}" Margin="0,10,0,0"/>
                </Grid>
            </Grid>
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" HeightRequest="50"/>
    </Grid>
</ContentPage>